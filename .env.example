# ─────────────────────────────────────────────────────────────
# Wolffun PM Dashboard — environment config
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Review 360° base URL (used by both BE scraper + FE postMessage allowlist)
REVIEW_360_URL=https://your-review-app.web.app

# Comma-separated origins allowed to postMessage the dashboard.
# BE reads this; FE mirrors the same list via VITE_ALLOWED_ORIGINS below.
BRIDGE_ALLOWED_ORIGINS=https://your-review-app.web.app,https://your-review-app.firebaseapp.com

# ── Frontend (Vite exposes only VITE_-prefixed vars to the client) ──
VITE_REVIEW_360_URL=https://your-review-app.web.app/my-work
VITE_ALLOWED_ORIGINS=https://your-review-app.web.app,https://your-review-app.firebaseapp.com

# Background scrape (set to 0 to disable)
BRIDGE_BG_SCRAPE_INTERVAL_SEC=300
# Cache freshness window — manual /scrape returns cached result if newer than this
BRIDGE_CACHE_MAX_AGE_SEC=60
